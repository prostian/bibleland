# Einzelseiten-Anwendung: Alle unbekannten Pfade an die index.html.
#
# Bibleland nutzt echte URLs (/ereignis/abraham-kanaan, /person/paulus,
# /graph/person/paulus). Die gibt es als Dateien nicht — das Routing passiert
# im Browser. Ohne diese Regel antwortet der Server bei jedem Neuladen und bei
# jedem geteilten Link mit 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Vorhandene Dateien und Verzeichnisse unveraendert ausliefern,
  # sonst wuerden auch /assets/index-*.js und /favicon an die App gehen.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HTTPS erzwingen.
  #
  # Der Server leitet HTTP zwar mit 301 auf HTTPS um, aber der erste Aufruf
  # geht dabei unverschluesselt hinaus — und Chrome zeigt in diesem Moment
  # "Nicht sicher" in der Adresszeile. Wer einen Link ohne https:// weitergibt,
  # loest genau das aus.
  #
  # Mit diesem Header merkt sich der Browser nach dem ersten Besuch, dass die
  # Adresse nur ueber HTTPS erreichbar ist, und schaltet kuenftig schon vor dem
  # Netzwerkzugriff um. Bewusst ohne includeSubDomains und ohne preload: Das
  # gilt nur fuer diesen Host und laesst sich jederzeit zuruecknehmen.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Keine geratenen Inhaltstypen, keine Einbettung in fremde Seiten,
  # keine vollstaendige Adresse an fremde Server.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Die gehashten Dateinamen in /assets aendern sich bei jedem Build, deshalb
  # duerfen sie lange zwischengespeichert werden. Die index.html dagegen nie —
  # sonst zeigt der Browser nach einem Deploy weiter die alte Fassung.
  <FilesMatch "\.(js|css|woff2|png|svg|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Nur die Produktionsadresse gehoert in Suchmaschinen.
#
# Seit es dev.biblego.info gibt, steht dieselbe Anwendung unter mehreren
# Adressen — dazu kommen die Vorschau-URLs, die Deploy Now fuer
# Staging-Deployments vergibt. Ohne diese Regel indiziert Google sie alle und
# behandelt sie als doppelten Inhalt; im schlimmsten Fall steht dann der
# Entwicklungsstand im Suchergebnis statt der fertigen Seite.
#
# Die Bedingung ist bewusst herum: indexierbar ist *nur* der exakte Host
# biblego.info, alles andere bekommt noindex. Eine Positivliste kann keine
# neue Vorschau-URL uebersehen. www.biblego.info braucht keine Ausnahme, es
# leitet ohnehin mit 301 auf die Hauptadresse um.
#
# Die beiden IfModule sind ineinander geschachtelt, und das ist wichtig:
# Fehlte mod_setenvif, waere IS_PROD nirgends gesetzt — die Regel wuerde dann
# auch die Produktionsseite aus dem Index nehmen. So wird ohne das Modul gar
# nichts gesetzt.
<IfModule mod_setenvif.c>
  <IfModule mod_headers.c>
    SetEnvIf Host "^biblego\.info$" IS_PROD
    Header always set X-Robots-Tag "noindex, nofollow" env=!IS_PROD
  </IfModule>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
